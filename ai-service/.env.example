# OpenAI API Key (미설정 시 Mock 모드로 동작)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# --- 태스크별 모델 분리 ---
# 인터뷰 질문 생성: 출력 23토큰 수준의 짧은 생성이라 소형 모델로 충분하다.
OPENAI_MODEL_INTERVIEW=gpt-4o-mini
# 회의록 분석: misunderstandings 추출이 서비스의 핵심이므로 플래그십을 쓴다.
# (계정에 gpt-5.6 계열 접근 권한이 없다면 gpt-4o 로 대체)
OPENAI_MODEL_ANALYSIS=gpt-5.6-terra

OPENAI_TEMPERATURE=0.4

PORT=8000

# CORS 허용 오리진 (쉼표 구분)
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
